[MASTER]
# src 레이아웃(패키지 미설치)에서 pylint가 파일 하나만 분석할 때도(예: 개별 테스트
# 파일) `childlock` 패키지를 찾을 수 있도록 src를 sys.path에 추가한다. CI(ci.yml)가
# 모든 .py 파일을 한 번에 검사하므로 이 hook 없이는 tests/* 파일 분석 시
# import-error(E0401)가 발생한다.
init-hook='import sys; sys.path.insert(0, "src")'

[BASIC]
# CLAUDE.md 구현 지침: 함수명/변수명 3글자 이상, camelCase.
function-rgx=^[a-z][a-zA-Z0-9]{2,}$
variable-rgx=^[a-z][a-zA-Z0-9]{2,}$
argument-rgx=^[a-z][a-zA-Z0-9]{2,}$
attr-rgx=^[a-z][a-zA-Z0-9]{2,}$
# 일반 메서드는 3글자 이상 camelCase. 예외 두 가지:
#  (1) Python/dataclass가 강제하는 정확한 이름의 던더 메서드(예: __init__, __post_init__)는
#      이름을 바꿀 수 없다(SWD-001 §5, 예: RuleDecision.__post_init__ 불변조건 검증).
#  (2) `tdd` 스킬이 명시적으로 규정한 unittest 테스트 메서드명 관례
#      (`test_<camelCase 설명>`, 예: test_rejectsEmptyEmail)는 unittest 자동탐색
#      접두어 "test"와 결합되므로 순수 camelCase가 될 수 없어 별도 허용한다.
method-rgx=^(__[a-z][a-zA-Z0-9_]*__|test_[a-z][a-zA-Z0-9]{2,}|[a-z][a-zA-Z0-9]{2,})$
# SWD-001 §2.1 패키지 구조가 파일명을 클래스명과 1:1 camelCase로 명시적으로 확정했으므로
# (예: vehicleSignalGateway.py), 모듈명도 동일 규칙(3글자 이상 camelCase)을 적용한다.
# 테스트 모듈은 unittest discover 관례상 `test_` 접두어가 필요하므로 함께 허용한다.
module-rgx=^(test_[a-z][a-zA-Z0-9]{2,}|[a-z][a-zA-Z0-9]{2,})$
good-names=i,j,k,_

[SIMILARITIES]
# CLAUDE.md 구현 지침: 중복 코드는 7라인까지 허용 (8라인부터 위반으로 보고).
min-similarity-lines=8
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes

[MESSAGES CONTROL]
# too-few-public-methods(R0903): SWD-001 §2.3/§3.1이 ISP·전략 패턴에 따라 인터페이스와
# 규칙(Rule) 클래스를 의도적으로 공개 메서드 1개(evaluate/decide/now 등)로 설계했다.
# missing-class-docstring/missing-function-docstring(C0115/C0116): `tdd` 스킬이 테스트
# 함수 문서화 방식을 함수 본문 docstring이 아니라 def 직전의 Doxygen 스타일 라인 주석
# (`## @brief ...`)으로 명시적으로 규정했다(테스트 함수 주석 규칙). 이 표준을 따르면
# 함수 본문에는 별도 docstring이 없으므로 이 두 체크와 구조적으로 충돌한다.
# 이 3개는 모두 CLAUDE.md의 5개 품질 지표(라인수/복잡도/중복/주석비율/네이밍)에
# 포함되지 않는 pylint 기본 휴리스틱이므로 비활성화한다.
disable=too-few-public-methods,missing-class-docstring,missing-function-docstring
